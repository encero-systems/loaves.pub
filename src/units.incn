"""
Compiled units as registry assets: one Oven store entry, packed into one deterministic archive.

`oven compile-closure` writes a result directory: `closure.json` (`incan.oven.closure/1`), which lists every unit it
compiled with its Loaf, version, features, domain, profile, target, unit identity and library, and `entries/`, one
directory per unit named by its identity. An asset is one unit. Its archive holds the entry's `artifact.json`, its
library once, as `payload` (installing it checks the digest and writes it back to the unit's `artifact` path), and every
other file under its `artifacts/`, written with the rules of a source Loaf archive. The binding an asset is filed under
is the closure's Rust compiler and the unit's target, profile and features.
"""

from std.fs import Path
from std.json import JsonValue

from admission import validate_binding
from adoption import loaf_name
from canonical import canonical, digest_bytes, digest_text, is_sha256_identity, pretty
from events import member, string_member, write_text
from oci import Layer, Registry, SOURCE_REPOSITORY, package_description, push, repository, version_tag
from registry import Binding
from tar import TarEntry, write_archive

pub const UNIT_ARTIFACT: str = "application/vnd.incan.unit.v1"
pub const UNIT_LAYER: str = "application/vnd.incan.unit.v1.tar"
pub const CLOSURE_SCHEMA: str = "incan.oven.closure/1"


@derive(Clone)
pub model CompiledUnit:
    """
    One unit a closure compiled: its Loaf and version, its unit identity (which also names its store entry), the digest
    and result-relative path of its library, and the binding it was compiled under.
    """

    pub loaf: str
    pub version: str
    pub unit: str
    pub payload: str
    pub library: str
    pub binding: Binding


@derive(Clone)
pub model Packed:
    """One unit's archive: the crates.io package it belongs to, its identities, its binding and the archive file."""

    pub name: str
    pub version: str
    pub unit: str
    pub entry: str
    pub payload: str
    pub binding: Binding
    pub archive: str
    pub path: str


pub def closure_units(result: str) -> Result[list[CompiledUnit], str]:
    """
    The `units` of a compile-closure result's `closure.json`. A closure that refused anything has no units to publish,
    and every unit is checked before any is packed.
    """
    label = result + "/closure.json"
    value = read_json(label)?
    if string_member(value, "schema") != CLOSURE_SCHEMA:
        return Err(f"{label}: schema must be {CLOSURE_SCHEMA}, the result `oven compile-closure` writes")
    refused = member(value, "refused")
    if refused.is_array() and refused.len() > 0:
        return Err(f"{label}: the closure refused {canonical(refused)?}")
    rustc = string_member(member(value, "toolchain"), "rustc")
    match member(value, "units").as_array():
        Some(items) =>
            mut out: list[CompiledUnit] = []
            for item in items:
                out.append(compiled_unit(item, rustc, label)?)
            return Ok(out)
        None => return Err(f"{label}: no `units`")


def compiled_unit(item: JsonValue, rustc: str, label: str) -> Result[CompiledUnit, str]:
    """One listed unit, read and checked: an adopted Loaf, one identity, a library inside its own entry, a binding."""
    loaf = string_member(item, "loaf")
    version = string_member(item, "version")
    if not loaf.startswith("crates-io/") or len(version) == 0:
        return Err(f"{label}: unit {canonical(item)?} names no adopted crates.io Loaf")
    where = f"{label}: {loaf} {version}"
    unit = string_member(item, "entry")
    if not is_sha256_identity(unit) or string_member(item, "unit") != unit:
        return Err(f"{where}: `entry` and `unit` must be the same `sha256:` identity")
    mut payload = string_member(item, "payload_digest")
    if not payload.startswith("sha256:"):
        payload = "sha256:" + payload
    if not is_sha256_identity(payload):
        return Err(f"{where}: `payload_digest` must be a SHA-256 digest")
    library = string_member(item, "artifact")
    entry_files = "entries/sha256-" + unit[7:] + "/artifacts/"
    if not library.startswith(entry_files) or len(library) == len(entry_files) or library[len(entry_files):].contains("/"):
        return Err(f"{where}: `artifact` must name a file directly in {entry_files}")
    binding = validate_binding(JsonValue.object({
        "toolchain": JsonValue.string(rustc),
        "target": member(item, "target"),
        "profile": member(item, "profile"),
        "features": member(item, "features"),
    }), where)?
    return Ok(CompiledUnit(loaf=loaf, version=version, unit=unit, payload=payload, library=library, binding=binding))


pub def pack_unit(result: str, unit: CompiledUnit, out: str) -> Result[Packed, str]:
    """
    Pack one store entry as `<out>/<archive hex>.tar`.

    The entry's `artifact.json` must name the unit, and its library must have the digest the closure gives it, so an
    archive never carries another unit's bytes.
    """
    label = f"{unit.loaf} {unit.version}"
    directory = result + "/entries/sha256-" + unit.unit[7:]
    artifact_bytes = read_bytes(directory + "/artifact.json")?
    artifact = parse_json(artifact_bytes, directory + "/artifact.json")?
    if string_member(artifact, "entry") != unit.unit:
        return Err(f"{label}: store entry sha256-{unit.unit[7:]} does not hold unit {unit.unit}")
    payload_bytes = read_bytes(result + "/" + unit.library)?
    if digest_bytes(payload_bytes) != unit.payload:
        return Err(f"{label}: its library is not {unit.payload}")
    mut entries: list[TarEntry] = [
        TarEntry(path="artifact.json", executable=false, data=artifact_bytes),
        TarEntry(path="payload", executable=false, data=payload_bytes),
    ]
    # The library travels once, as `payload`.
    library = "artifacts/" + unit.library.split("/artifacts/")[1]
    entries = entries + artifact_files(directory + "/artifacts", "artifacts", library, label)?
    archive = write_archive(entries)?
    digest = digest_bytes(archive)
    path = out + "/" + digest[7:] + ".tar"
    match Path(path).write_bytes(archive):
        Ok(_) => pass
        Err(error) => return Err(f"{path}: {error.message()}")
    return Ok(Packed(
        name=unit.loaf[10:],
        version=unit.version,
        unit=unit.unit,
        entry=unit.unit,
        payload=unit.payload,
        binding=unit.binding,
        archive=digest,
        path=path,
    ))


pub def pack_closure(result: str, only: list[str], out: str) -> Result[list[Packed], str]:
    """
    Pack every unit a closure compiled into `out`, or with `only` just the units of those `NAME@VERSION`s, each of which
    must match a unit the closure compiled.
    """
    mut packed: list[Packed] = []
    mut matched: list[str] = []
    for unit in closure_units(result)?:
        selector = unit.loaf[10:] + "@" + unit.version
        if len(only) > 0 and not only.contains(selector):
            continue
        matched.append(selector)
        packed.append(pack_unit(result, unit, out)?)
    for selector in only:
        if not matched.contains(selector):
            return Err(f"--only names {selector}, which {result} did not compile")
    return Ok(packed)


pub def reproduction_differences(first: list[Packed], second: list[Packed]) -> list[str]:
    """
    How two compiles of one closure disagree, unit by unit: nothing when every unit has the same unit identity, entry
    and archive in both. Units pair up by package, version and binding, in the order the closure lists them.
    """
    mut by_selection: Dict[str, list[Packed]] = {}
    for item in second:
        key = selection_key(item)
        mut members: list[Packed] = []
        if key in by_selection:
            members = by_selection[key]
        members.append(item)
        by_selection[key] = members
    mut taken: Dict[str, int] = {}
    mut differences: list[str] = []
    for item in first:
        key = selection_key(item)
        mut index = 0
        if key in taken:
            index = taken[key]
        taken[key] = index + 1
        if key not in by_selection or index >= len(by_selection[key]):
            differences.append(f"{item.name} {item.version} was compiled in only one root")
            continue
        other = by_selection[key][index]
        if other.unit != item.unit or other.entry != item.entry or other.archive != item.archive:
            differences.append(f"{item.name} {item.version} is unit {item.unit} with archive {item.archive} in one root and unit {other.unit} with archive {other.archive} in the other")
    if len(first) != len(second):
        differences.append(f"one root compiled {len(first)} unit(s) and the other {len(second)}")
    return differences


def selection_key(item: Packed) -> str:
    return item.name + "\t" + item.version + "\t" + item.binding.key()


def artifact_files(directory: str, prefix: str, skip: str, label: str) -> Result[list[TarEntry], str]:
    """
    Every file under an entry's `artifacts/` but `skip`, at its path below the entry. The archive digest covers their
    bytes, and the second compile in another root must give the same archive, so a file that depends on the machine is
    refused.
    """
    mut out: list[TarEntry] = []
    match Path(directory).iterdir():
        Ok(children) =>
            for child in children:
                path = prefix + "/" + child.name()
                if path == skip:
                    continue
                if child.is_dir():
                    out = out + artifact_files(directory + "/" + child.name(), path, skip, label)?
                elif child.is_file():
                    out.append(TarEntry(path=path, executable=false, data=read_bytes(directory + "/" + child.name())?))
                else:
                    return Err(f"{label}: {path} is neither a file nor a directory")
        Err(error) => return Err(f"{label}: {directory}: {error.message()}")
    return Ok(out)


pub def unit_tag(version: str, binding: Binding) -> Result[str, str]:
    """A binding's tag: the version's tag, `-`, and the first 12 hex digits of the binding's canonical JSON digest."""
    tag = version_tag(version)? + "-" + digest_text(canonical(binding.to_json())?)[7:19]
    if len(tag) > 128:
        return Err(f"version `{version}` is too long to tag a binding")
    return Ok(tag)


pub def push_units(
    registry: Registry, packed: list[Packed], builder: str, attestation: str, toolchain: str, proposals: str
) -> Result[list[str], str]:
    """
    Push every binding's units under that binding's tag, one layer per unit, and write one asset proposal per unit.

    A tag gathers every unit compiled under its binding, whatever closure compiled it, so a push adds its layers to
    those the tag already lists. The proposals are what `admit-assets` records on the index.
    """
    mut groups: Dict[str, list[Packed]] = {}
    for item in packed:
        key = item.name + "\t" + item.version + "\t" + item.binding.key()
        mut members: list[Packed] = []
        if key in groups:
            members = groups[key]
        members.append(item)
        groups[key] = members
    mut pushed: list[str] = []
    for key in sorted(list(groups.keys())):
        members = groups[key]
        first = members[0]
        repository_name = repository(registry, "crates-io", first.name)
        binding_text = canonical(first.binding.to_json())?
        tag = unit_tag(first.version, first.binding)?
        mut layers: list[Layer] = []
        for item in members:
            layers.append(Layer(path=item.path, media_type=UNIT_LAYER, annotations={
                "org.opencontainers.image.title": f"{item.name}-{item.version}-{item.unit[7:19]}.tar",
                "dev.incan.unit.identity": item.unit,
                "dev.incan.unit.entry": item.entry,
                "dev.incan.binding": binding_text,
            }))
        annotations: Dict[str, str] = {
            "org.opencontainers.image.source": SOURCE_REPOSITORY,
            "org.opencontainers.image.description": package_description("crates-io", first.name),
            "dev.incan.loaf.name": loaf_name(first.name),
            "dev.incan.loaf.version": first.version,
            "dev.incan.binding": binding_text,
        }
        manifest_digest = push(registry, repository_name, tag, UNIT_ARTIFACT, layers, annotations, true)?
        location = JsonValue.object({
            "registry": JsonValue.string(registry.host),
            "repository": JsonValue.string(repository_name),
            "tag": JsonValue.string(tag),
        })
        for item in members:
            proposal = JsonValue.object({
                "name": JsonValue.string(item.name),
                "version": JsonValue.string(item.version),
                "binding": item.binding.to_json(),
                "asset": JsonValue.object({
                    "archive": JsonValue.string(item.archive),
                    "unit_identity": JsonValue.string(item.unit),
                    "entry": JsonValue.string(item.entry),
                    "payload": JsonValue.string(item.payload),
                    "builder": JsonValue.string(builder),
                    "attestation": JsonValue.string(attestation),
                    "toolchain": JsonValue.string(toolchain),
                    "location": location,
                }),
            })
            write_text(Path(proposals + "/" + item.archive[7:] + ".json"), pretty(proposal)? + "\n", "asset proposal")?
        pushed.append(f"{registry.host}/{repository_name}:{tag} {manifest_digest}")
    return Ok(pushed)


pub def packed_json(packed: Packed) -> JsonValue:
    """One line of `units.json`, the list `pack-units` leaves beside the archives for `push-units`."""
    return JsonValue.object({
        "name": JsonValue.string(packed.name),
        "version": JsonValue.string(packed.version),
        "unit": JsonValue.string(packed.unit),
        "entry": JsonValue.string(packed.entry),
        "payload": JsonValue.string(packed.payload),
        "binding": packed.binding.to_json(),
        "archive": JsonValue.string(packed.archive),
    })


pub def packed_from_json(value: JsonValue, directory: str) -> Result[Packed, str]:
    archive = string_member(value, "archive")
    if not is_sha256_identity(archive):
        return Err(f"{directory}/units.json: an archive is not a `sha256:` identity")
    return Ok(Packed(
        name=string_member(value, "name"),
        version=string_member(value, "version"),
        unit=string_member(value, "unit"),
        entry=string_member(value, "entry"),
        payload=string_member(value, "payload"),
        binding=validate_binding(member(value, "binding"), f"{directory}/units.json")?,
        archive=archive,
        path=directory + "/" + archive[7:] + ".tar",
    ))


pub def write_units(directory: str, packed: list[Packed]) -> Result[None, str]:
    mut items: list[JsonValue] = []
    for item in packed:
        items.append(packed_json(item))
    return write_text(Path(directory + "/units.json"), pretty(JsonValue.array(items))? + "\n", "units.json")


pub def read_units(directory: str) -> Result[list[Packed], str]:
    value = read_json(directory + "/units.json")?
    mut out: list[Packed] = []
    match value.as_array():
        Some(items) =>
            for item in items:
                out.append(packed_from_json(item, directory)?)
        None => return Err(f"{directory}/units.json: not a list")
    return Ok(out)


def read_json(path: str) -> Result[JsonValue, str]:
    return parse_json(read_bytes(path)?, path)


def parse_json(data: bytes, path: str) -> Result[JsonValue, str]:
    match data.decode():
        Ok(text) =>
            match JsonValue.parse(text):
                Ok(value) => return Ok(value)
                Err(error) => return Err(f"{path}: {error.message()}")
        Err(_) => return Err(f"{path}: not UTF-8")


def read_bytes(path: str) -> Result[bytes, str]:
    match Path(path).read_bytes():
        Ok(data) => return Ok(data)
        Err(error) => return Err(f"{path}: {error.message()}")
