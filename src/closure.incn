"""
Adopting package versions together with everything they depend on.

Admission refuses an `adopt` event whose dependencies are not adopted yet, so versions are adopted in dependency
order, after the whole closure is planned. The closure is what a consumer of each named version builds with its
default features, on any target: the walk follows the features every dependent enables on a dependency. A
requirement is met by a version already adopted or planned; otherwise by the newest crates.io version satisfying it
that intake lets in (src/intake.incn), preferring one that is not yanked. A version named explicitly must pass intake
too, unless the caller accepts its hazards. Each planned version is downloaded once into the cache and verified
against the crates.io checksum before it is read, then translated, and its source Loaf archive is stored under its
digest in the blob store. Nothing is appended to the log until the plan is complete and ordered.
"""

from std.fs import Path
from std.json import JsonValue, parse, parse_jsonl
from std.toml import TomlValue

from adoption import (
    Adoption,
    activations,
    adoption_from_payload,
    build_activations,
    loaf_files,
    render_adopted_manifest,
    required_dependencies,
    source_archive,
    translate,
    unpack_crate,
)
from canonical import canonical, digest_bytes, digest_text, is_sha256_identity
from events import member, read_text, string_member
from host import download
from registry import crates_io_sparse_url, registry_name, sparse_index_path
from intake import intake_problems
from semver import Version, compare, parse_requirement, parse_version, satisfies


@derive(Clone)
pub model Planned:
    """One version ready to adopt: what adoption decided, and the digests of the manifest and archive it produced."""

    pub adoption: Adoption
    pub manifest: str
    pub archive: str


pub def crates_io_lines(cache: str, package: str) -> Result[list[JsonValue], str]:
    """Every crates.io index line of `package`, fetched into the cache the first time it is needed."""
    relative = "index/" + sparse_index_path(package)
    location = cache + "/" + relative
    path = Path(location)
    if not path.is_file():
        make_parent(path, relative)?
        download(crates_io_sparse_url(package), location)?
    match parse_jsonl(read_text(path, relative)?):
        Ok(lines) => return Ok(lines)
        Err(error) => return Err(f"{relative}: not a crates.io index file: {error.message()}")


pub def crate_archive(cache: str, package: str, version: str, checksum: str) -> Result[bytes, str]:
    """The `.crate` of one version, fetched into the cache and checked against its crates.io checksum."""
    relative = f"crates/{package}/{package}-{version}.crate"
    location = cache + "/" + relative
    path = Path(location)
    if not path.is_file():
        make_parent(path, relative)?
        download(f"https://static.crates.io/crates/{package}/{package}-{version}.crate", location)?
    mut data = b""
    match path.read_bytes():
        Ok(bytes_read) => data = bytes_read
        Err(error) => return Err(f"{relative}: {error.message()}")
    if digest_bytes(data) != "sha256:" + checksum:
        return Err(f"{relative}: its digest is not the crates.io checksum {checksum}; remove it and adopt again")
    return Ok(data)


pub def prepare(cache: str, blobs: str, line: JsonValue) -> Result[Planned, str]:
    """Translate one version and store its source Loaf archive; the log is not touched."""
    package = string_member(line, "name")
    version = string_member(line, "vers")
    files = unpack_crate(package, version, crate_archive(cache, package, version, string_member(line, "cksum"))?)?
    adoption = translate(line, files)?
    manifest = render_adopted_manifest(adoption)
    archive = source_archive(manifest, loaf_files(adoption, files, registry_name()))?
    digest = digest_bytes(archive)
    location = blobs + "/sha256/" + digest[7:] + ".tar"
    path = Path(location)
    if not path.is_file():
        make_parent(path, location)?
        match path.write_bytes(archive):
            Ok(_) => pass
            Err(error) => return Err(f"{location}: {error.message()}")
    return Ok(Planned(adoption=adoption, manifest=digest_text(manifest), archive=digest))


pub def reproduce(cache: str, blobs: str, line: JsonValue, payload: JsonValue, adopted_under: str) -> Result[str, str]:
    """
    Rebuild the source Loaf archive an `adopt` event recorded and store it; return its digest.

    The manifest is rendered from the event's own payload, not from translating the package again, so the archive is
    the one adopted whatever the translation has learned since (a rule added, an equivalent spelling changed). The
    files adoption added name the registry as it was named when the event was recorded (`adopted_under`).
    """
    package = string_member(line, "name")
    version = string_member(line, "vers")
    files = unpack_crate(package, version, crate_archive(cache, package, version, string_member(line, "cksum"))?)?
    adoption = adoption_from_payload(payload, f"{package} {version}")?
    manifest = render_adopted_manifest(adoption)
    archive = source_archive(manifest, loaf_files(adoption, files, adopted_under))?
    digest = digest_bytes(archive)
    location = blobs + "/sha256/" + digest[7:] + ".tar"
    path = Path(location)
    if not path.is_file():
        make_parent(path, location)?
        match path.write_bytes(archive):
            Ok(_) => pass
            Err(error) => return Err(f"{location}: {error.message()}")
    return Ok(digest)


pub def blob_path(blobs: Path, digest: str) -> Path:
    """Where a source Loaf archive lives in the blob store: `sha256/<hex>.tar`."""
    return blobs / "sha256" / (digest[7:] + ".tar")


pub def plan_closure(
    adopted: Dict[str, Adoption],
    targets: list[list[str]],
    cache: str,
    blobs: str,
    now: int,
    accept_hazards: bool,
) -> Result[list[Planned], str]:
    """
    Every version to adopt for `targets`, dependencies first.

    `adopted` holds what the log adopted, keyed `<package>\t<version>`. Each target is built with its default
    features and any it names after its version, and the walk follows the features every dependent enables on a dependency, through adopted versions as
    well: an optional dependency that only a dependent's feature switches on is in the closure a consumer of the
    target builds, though no version's own defaults name it. A version planned for the first time also gets its own
    default features, since admission holds it to its default closure. A version with a build script brings its
    active build dependencies too: recording the script's fact compiles it against them. A requirement is met by the
    newest version adopted or planned that satisfies it.
    """
    mut versions: Dict[str, list[str]] = {}
    for key in adopted.keys():
        remember(versions, adopted[key].package.lower(), adopted[key].version)
    mut known: Dict[str, list[str]] = {}
    for package in versions.keys():
        known[package] = versions[package]
    mut planned: Dict[str, Planned] = {}
    # The features enabled so far on each version reached; a version is walked again whenever they grow.
    mut enabled: Dict[str, list[str]] = {}
    # Each entry is [package, version, feature...].
    mut queue: list[list[str]] = []
    for target in targets:
        # A target is [package, version, feature...]: its defaults and any features asked of it.
        queue.append([target[0].lower(), target[1], "default"] + target[2:])
    mut position = 0
    while position < len(queue):
        entry = queue[position]
        position += 1
        package = entry[0]
        version = entry[1]
        key = package + "\t" + version
        mut grew = key not in enabled
        mut features: list[str] = []
        if key in enabled:
            features = enabled[key]
        mut index = 2
        while index < len(entry):
            if not features.contains(entry[index]):
                features.append(entry[index])
                grew = true
            index += 1
        if not grew:
            continue
        if key not in adopted and key not in planned:
            lines = crates_io_lines(cache, package)?
            line = find_line(lines, package, version)?
            # A version chosen for a requirement passed intake already; one named explicitly is checked here.
            problems = intake_problems(lines, line, now)?
            if len(problems) > 0 and not accept_hazards:
                return Err(f"{package} {version}: " + "; ".join(problems) + "; pass --accept-hazards to adopt it anyway")
            item = prepare(cache, blobs, line)?
            planned[key] = item
            remember(known, package, version)
            println(f"planned: {package} {version}")
            # Admission holds every adopted version to its own default closure, whatever its dependents enable.
            if not features.contains("default"):
                features.append("default")
        enabled[key] = features
        adoption = adoption_of(adopted, planned, key)
        mut reached = activations(adoption, features)
        if adoption.build_script.unwrap_or(false):
            line = find_line(crates_io_lines(cache, package)?, package, version)?
            for activation in build_activations(line, features, f"{package} {version}")?:
                reached.append(activation)
        for activation in reached:
            dependency = activation.dependency
            mut choice = newest_meeting(known, dependency.package, dependency.req)?
            if len(choice) == 0:
                choice = choose(crates_io_lines(cache, dependency.package)?, dependency.package, dependency.req, now)?
                remember(known, dependency.package, choice)
            mut next = [dependency.package, choice]
            for feature in activation.features:
                next.append(feature)
            queue.append(next)
    return dependency_order(planned, versions)


def adoption_of(adopted: Dict[str, Adoption], planned: Dict[str, Planned], key: str) -> Adoption:
    if key in adopted:
        return adopted[key]
    return planned[key].adoption


def dependency_order(planned: Dict[str, Planned], adopted: Dict[str, list[str]]) -> Result[list[Planned], str]:
    """Repeatedly take every planned version whose requirements are already met; what never qualifies is a cycle."""
    mut done: Dict[str, list[str]] = {}
    for package in adopted.keys():
        done[package] = adopted[package]
    mut remaining = sorted(list(planned.keys()))
    mut out: list[Planned] = []
    while len(remaining) > 0:
        mut waiting: list[str] = []
        mut ready: list[Planned] = []
        for key in remaining:
            item = planned[key]
            mut satisfied = true
            for dependency in required_dependencies(item.adoption):
                if not met(done, dependency.package, dependency.req)?:
                    satisfied = false
                    break
            if satisfied:
                ready.append(item)
            else:
                waiting.append(key)
        if len(ready) == 0:
            listed = ", ".join([key.replace("\t", " ") for key in waiting])
            return Err(f"the closure has a dependency cycle no single adoption can open: [{listed}]")
        for item in ready:
            remember(done, item.adoption.package.lower(), item.adoption.version)
            out.append(item)
        remaining = waiting
    return Ok(out)


pub def find_line(lines: list[JsonValue], package: str, version: str) -> Result[JsonValue, str]:
    for line in lines:
        if string_member(line, "vers") == version:
            return Ok(line)
    return Err(f"crates.io publishes no {package} {version}")


pub def newest_stable(cache: str, package: str, now: int) -> Result[str, str]:
    """
    The newest crates.io version of `package` that is not a pre-release and that intake lets in, preferring one that is
    not yanked.
    """
    return choose(crates_io_lines(cache, package)?, package, "*", now)


@derive(Clone)
pub model Addition:
    """
    One additions-list entry: the package, and the feature shape its consumers build it with: whether they keep its
    default features, and the features they turn on. Adoption plans the defaults whatever the shape, because admission
    holds every adoption to its default closure; the shape is what the package's bake shards request.
    """

    pub name: str
    pub default_features: bool
    pub features: list[str]


pub def additions(text: str, label: str) -> Result[list[Addition], str]:
    """
    The entries an additions list holds, in order and each package once. An entry is a crates.io package name, then
    optionally `-default` when its consumers turn default features off and `+feature` for each feature they turn on;
    blank lines and `#` comments are skipped, and a comment may follow an entry.
    """
    mut out: list[Addition] = []
    mut seen: list[str] = []
    for line in text.split("\n"):
        mut tokens: list[str] = []
        for token in line.split("#")[0].replace("\t", " ").split(" "):
            if len(token) > 0:
                tokens.append(token)
        if len(tokens) == 0:
            continue
        name = tokens[0]
        if not crates_io_name(name):
            return Err(f"{label}: `{name}` is not a crates.io package name")
        mut entry = Addition(name=name, default_features=true, features=[])
        for token in tokens[1:]:
            if token == "-default":
                entry.default_features = false
            elif token.startswith("+") and crates_io_name(token[1:]):
                if not entry.features.contains(token[1:]):
                    entry.features.append(token[1:])
            else:
                return Err(f"{label}: `{name}`: `{token}` is neither `-default` nor `+feature`")
        if seen.contains(name):
            return Err(f"{label}: `{name}` is listed twice")
        seen.append(name)
        out.append(entry)
    return Ok(out)


def crates_io_name(text: str) -> bool:
    """Whether `text` is spelled as a crates.io package or feature name: ASCII letters, digits, `_` and `-`."""
    if len(text) == 0:
        return false
    for character in text:
        if not "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-".contains(character):
            return false
    return true


pub def choose(lines: list[JsonValue], package: str, requirement: str, now: int) -> Result[str, str]:
    """
    The newest version satisfying `requirement` that intake lets in (src/intake.incn), preferring one that is not
    yanked; refused with every passed-over version's reason when none qualifies.
    """
    comparators = parse_requirement(requirement)?
    mut satisfying: list[JsonValue] = []
    for line in lines:
        match parse_version(string_member(line, "vers")):
            Ok(version) =>
                if satisfies(version, comparators):
                    satisfying = insert_preferred(satisfying, line)?
            Err(_) => pass
    if len(satisfying) == 0:
        return Err(f"no crates.io version of {package} satisfies `{requirement}`")
    mut passed_over: list[str] = []
    for line in satisfying:
        problems = intake_problems(lines, line, now)?
        if len(problems) == 0:
            return Ok(string_member(line, "vers"))
        passed_over.append(string_member(line, "vers") + ": " + "; ".join(problems))
    listed = " | ".join(passed_over)
    return Err(f"no crates.io version of {package} satisfying `{requirement}` passes intake: {listed}")


def insert_preferred(ordered: list[JsonValue], line: JsonValue) -> Result[list[JsonValue], str]:
    """`ordered` with `line` in preference order: versions not yanked first, newest first within each."""
    version = parse_version(string_member(line, "vers"))?
    yanked = flag(line, "yanked")
    mut out: list[JsonValue] = []
    mut placed = false
    for other in ordered:
        other_yanked = flag(other, "yanked")
        newer = compare(version, parse_version(string_member(other, "vers"))?) > 0
        if not placed and ((not yanked and other_yanked) or (yanked == other_yanked and newer)):
            out.append(line)
            placed = true
        out.append(other)
    if not placed:
        out.append(line)
    return Ok(out)


def met(known: Dict[str, list[str]], package: str, requirement: str) -> Result[bool, str]:
    comparators = parse_requirement(requirement)?
    if package not in known:
        return Ok(false)
    for text in known[package]:
        version = parse_version(text)?
        if satisfies(version, comparators):
            return Ok(true)
    return Ok(false)


def newest_meeting(known: Dict[str, list[str]], package: str, requirement: str) -> Result[str, str]:
    """The newest known version of `package` satisfying `requirement`, or empty when none does."""
    comparators = parse_requirement(requirement)?
    if package not in known:
        return Ok("")
    mut best: Option[Version] = None
    mut best_text = ""
    for text in known[package]:
        version = parse_version(text)?
        if not satisfies(version, comparators):
            continue
        match best:
            Some(current) =>
                if compare(version, current) > 0:
                    best = Some(version)
                    best_text = text
            None =>
                best = Some(version)
                best_text = text
    return Ok(best_text)


def remember(mut known: Dict[str, list[str]], package: str, version: str) -> None:
    mut versions: list[str] = []
    if package in known:
        versions = known[package]
    if not versions.contains(version):
        versions.append(version)
    known[package] = versions


def flag(value: JsonValue, key: str) -> bool:
    match value.get(key):
        Some(found) =>
            match found.as_bool():
                Some(flag_value) => return flag_value
                None => return false
        None => return false


def make_parent(path: Path, label: str) -> Result[None, str]:
    match path.parent().mkdir(parents=true, exist_ok=true):
        Ok(_) => return Ok(None)
        Err(error) => return Err(f"{label}: {error.message()}")


@derive(Clone)
pub model LockedArchive:
    """One source Loaf archive a lock pins: the Loaf, its version and the archive's digest."""

    pub loaf: str
    pub version: str
    pub digest: str


pub def locked_archives(text: str, label: str) -> Result[list[LockedArchive], str]:
    """
    The crates.io source archives a lock pins. The lock is an `oven.lock` (format 1, what `oven compile-closure`
    compiles), whose `[[loaf]]` entries name each archive by `checksum`, or a resolution (`incan.oven.loaf-resolution/1`,
    the lock beside a fact's graph), whose `units` name it by `archive_digest`.
    """
    if text.strip().startswith("{"):
        return resolution_archives(text, label)
    match TomlValue.parse(text):
        Ok(document) => return oven_lock_archives(document, label)
        Err(error) => return Err(f"{label}: neither a resolution nor an oven.lock: {error.message()}")


def oven_lock_archives(document: TomlValue, label: str) -> Result[list[LockedArchive], str]:
    """Every registry entry of an oven.lock; an entry the toolchain itself supplies has no archive to fetch."""
    match document.get_optional[int]("format"):
        Ok(found) =>
            if found.unwrap_or(0) != 1:
                return Err(f"{label}: an oven.lock this tool reads is format 1")
        Err(error) => return Err(f"{label}: `format`: {error.message()}")
    mut out: list[LockedArchive] = []
    match document.get_value_key("loaf"):
        Ok(value) =>
            match value.as_array():
                Ok(entries) =>
                    for entry in entries:
                        match oven_lock_archive(entry, label)?:
                            Some(found) => out.append(found)
                            None => pass
                Err(error) => return Err(f"{label}: `loaf` is an array of tables: {error.message()}")
        Err(_) => pass
    return Ok(out)


def oven_lock_archive(entry: TomlValue, label: str) -> Result[Option[LockedArchive], str]:
    """One `[[loaf]]` entry: a crates.io Loaf names its archive by `checksum`; any other Loaf has none to fetch."""
    name = toml_text(entry, "name", label)?
    if not name.startswith("crates-io/"):
        return Ok(None)
    version = toml_text(entry, "version", label)?
    digest = toml_text(entry, "checksum", label)?
    if len(version) == 0 or not is_sha256_identity(digest):
        return Err(f"{label}: {name} {version} names no `sha256:` checksum for its source archive")
    return Ok(Some(LockedArchive(loaf=name, version=version, digest=digest)))


def toml_text(entry: TomlValue, key: str, label: str) -> Result[str, str]:
    match entry.get_optional[str](key):
        Ok(found) => return Ok(found.unwrap_or(""))
        Err(error) => return Err(f"{label}: `{key}`: {error.message()}")


def resolution_archives(text: str, label: str) -> Result[list[LockedArchive], str]:
    """Every unit of a resolution, by its `archive_digest`."""
    mut document = JsonValue.null()
    match parse(text):
        Ok(value) => document = value
        Err(error) => return Err(f"{label}: {error.message()}")
    mut out: list[LockedArchive] = []
    match member(document, "units").as_array():
        Some(units) =>
            for unit in units:
                loaf = string_member(unit, "loaf")
                digest = string_member(unit, "archive_digest")
                if not loaf.startswith("crates-io/") or not is_sha256_identity(digest):
                    return Err(f"{label}: unit {canonical(unit)?} names no crates.io Loaf archive")
                out.append(LockedArchive(loaf=loaf, version=string_member(unit, "version"), digest=digest))
            return Ok(out)
        None => return Err(f"{label}: no `units`")
