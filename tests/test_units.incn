"""
Compiled units as assets: packing a store entry, tagging a binding, and admitting an asset onto an adopted record.
"""

from std.fs import Path
from std.json import JsonValue, parse
from std.tempfile import TemporaryDirectory
from std.testing import assert_eq, assert_true

from admission import admit_asset, replay, require_toolchain
from adoption import Adoption, adoption_payload, render_adopted_manifest
from canonical import canonical, digest_bytes, digest_text
from closure import locked_archives
from events import append_event, load_events, write_text
from projection import render_projections
from host import environment_value
from oci import source_tag
from registry import Binding, Record, record_key
from tar import read_archive
from units import Packed, closure_units, pack_closure, reproduction_differences, unit_tag


def error_of[T](result: Result[T, str]) -> str:
    match result:
        Ok(_) => return ""
        Err(message) => return message


def scratch(name: str) -> str:
    """A fresh directory under the system temporary directory, as a path string."""
    location = environment_value("TMPDIR").unwrap_or("/tmp").strip() + "/loaves-pub-units-" + name
    path = Path(location)
    if path.is_dir():
        path.remove_tree().unwrap()
    path.mkdir(parents=true, exist_ok=true).unwrap()
    return location


def refusal(root: Path) -> str:
    match replay(load_events(root).unwrap(), root):
        Ok(_) => return ""
        Err(message) => return message


const TOOLCHAIN: str = "incan@0cb030e9c6d9817c620e481854e7d6f6440fd9d6"


def leaf() -> Adoption:
    return Adoption(
        package="leaf",
        version="1.2.0",
        checksum=digest_text("leaf"),
        rust_name="leaf",
        rust_type="lib",
        edition="2021",
        build_script=Some(false),
        about=None,
        files=None,
        root="src/lib.rs",
        features={"default": []},
        dependencies=[],
    )


def adopt_leaf(root: Path) -> None:
    payload = adoption_payload(leaf(), digest_text(render_adopted_manifest(leaf())), digest_text("archive leaf"))
    append_event(root, "adopt", "leaf", "1.2.0", "tests", payload).unwrap()


def binding_json(profile: str) -> JsonValue:
    return JsonValue.object({
        "toolchain": JsonValue.string("rustc 1.98.0 (88d9e12ae 2026-08-18)"),
        "target": JsonValue.string("aarch64-apple-darwin"),
        "profile": JsonValue.string(profile),
        "features": JsonValue.array([JsonValue.string("default")]),
    })


def add_asset(root: Path, profile: str, unit: str, archive: str) -> None:
    mut payload: Dict[str, JsonValue] = {}
    payload["binding"] = binding_json(profile)
    payload["asset"] = JsonValue.object({
        "archive": JsonValue.string(digest_text(archive)),
        "unit_identity": JsonValue.string(digest_text(unit)),
        "entry": JsonValue.string(digest_text("entry " + unit)),
        "payload": JsonValue.string(digest_text("payload " + unit)),
        "builder": JsonValue.string("registry"),
        "attestation": JsonValue.string("https://github.com/encero-systems/loaves.pub/attestations/1"),
        "location": JsonValue.object({
            "registry": JsonValue.string("ghcr.io"),
            "repository": JsonValue.string("encero-systems/loaves.pub/crates-io/leaf"),
            "tag": JsonValue.string("1.2.0-000000000000"),
        }),
    })
    append_event(root, "asset", "leaf", "1.2.0", "tests", payload).unwrap()


def adopt_second_revision(root: Path) -> None:
    mut corrected = leaf()
    corrected.edition = "2018"
    mut payload = adoption_payload(corrected, digest_text(render_adopted_manifest(corrected)), digest_text("archive r2"))
    payload["revision"] = JsonValue.int(2)
    payload["supersedes"] = JsonValue.int(1)
    payload["reason"] = JsonValue.string("the edition was read wrong")
    append_event(root, "adopt", "leaf", "1.2.0", "tests", payload).unwrap()


def recorded_asset(unit: str, revision: int, toolchain: str) -> JsonValue:
    mut fields: Dict[str, JsonValue] = {
        "archive": JsonValue.string(digest_text("archive " + unit)),
        "unit_identity": JsonValue.string(digest_text(unit)),
        "entry": JsonValue.string(digest_text("entry " + unit)),
        "payload": JsonValue.string(digest_text("payload " + unit)),
        "builder": JsonValue.string("registry"),
        "attestation": JsonValue.string("https://github.com/encero-systems/loaves.pub/attestations/1"),
        "location": JsonValue.object({
            "registry": JsonValue.string("ghcr.io"),
            "repository": JsonValue.string("encero-systems/loaves.pub/crates-io/leaf"),
            "tag": JsonValue.string("1.2.0-000000000000"),
        }),
        "revision": JsonValue.int(revision),
    }
    if len(toolchain) > 0:
        fields["toolchain"] = JsonValue.string(toolchain)
    return JsonValue.object(fields)


def test_an_asset_serves_the_revisions_it_names() -> None:
    directory = TemporaryDirectory.try_new().unwrap()
    root = directory.path()
    adopt_leaf(root)
    adopt_second_revision(root)
    add_asset(root, "debug", "first", "archive first")
    mut payload: Dict[str, JsonValue] = {}
    payload["binding"] = binding_json("release")
    payload["asset"] = recorded_asset("second", 2, TOOLCHAIN)
    append_event(root, "asset", "leaf", "1.2.0", "tests", payload).unwrap()
    assert_eq(refusal(root), "")
    events = load_events(root).unwrap()
    state = replay(events, root).unwrap()
    files = render_projections(state, events).unwrap()
    # An asset that names no revision was recorded against revision 1.
    assert_true(files["crates-io/leaf/1.2.0/r1/assets.json"].contains(digest_text("first")))
    assert_true(not files["crates-io/leaf/1.2.0/r1/assets.json"].contains(digest_text("second")))
    assert_true(files["crates-io/leaf/1.2.0/assets.json"].contains(digest_text("second")))
    assert_true(files["crates-io/leaf/1.2.0/assets.json"].contains(f"\"toolchain\": \"{TOOLCHAIN}\""))
    assert_true(not files["crates-io/leaf/1.2.0/assets.json"].contains(digest_text("first")))
    # The unit a revision's new bake did not change serves it too, under the same archive.
    record = admit_asset(state[record_key("leaf", "1.2.0")], binding_json("debug"), recorded_asset_of_first(), "again").unwrap()
    assert_eq(len(record.assets), 2)
    assert_eq(record.assets[0].revisions, [1, 2])


def recorded_asset_of_first() -> JsonValue:
    mut asset = recorded_asset("first", 2, "")
    asset.set("archive", JsonValue.string(digest_text("archive first"))).unwrap()
    return asset


def test_an_asset_names_an_existing_revision_and_a_well_formed_toolchain() -> None:
    directory = TemporaryDirectory.try_new().unwrap()
    root = directory.path()
    adopt_leaf(root)
    state = replay(load_events(root).unwrap(), root).unwrap()
    record = state[record_key("leaf", "1.2.0")]
    assert_true(
        error_of_record(admit_asset(record, binding_json("debug"), recorded_asset("unit", 2, TOOLCHAIN), "new"))
        .contains("the asset names revision 2")
    )
    assert_true(
        error_of_record(admit_asset(record, binding_json("debug"), recorded_asset("unit", 1, "rustc 1.98.0"), "new"))
        .contains("an asset's toolchain is `incan@`")
    )
    assert_eq(error_of_none(require_toolchain(recorded_asset("unit", 1, TOOLCHAIN), "new")), "")
    assert_eq(
        error_of_none(require_toolchain(recorded_asset("unit", 1, ""), "new")),
        "new: a new asset names its full toolchain identity in `toolchain`",
    )
    # A later revision's source archive has its own tag; revision 1 keeps the version's.
    assert_eq(source_tag("2.1.0+zstd.1.5.7", 1).unwrap(), "2.1.0_zstd.1.5.7")
    assert_eq(source_tag("2.1.0+zstd.1.5.7", 2).unwrap(), "2.1.0_zstd.1.5.7-r2")


def error_of_record(result: Result[Record, str]) -> str:
    match result:
        Ok(_) => return ""
        Err(message) => return message


def error_of_none(result: Result[None, str]) -> str:
    match result:
        Ok(_) => return ""
        Err(message) => return message


def test_an_asset_is_compiled_from_an_adopted_version_and_one_unit_has_one_archive() -> None:
    directory = TemporaryDirectory.try_new().unwrap()
    root = directory.path()
    adopt_leaf(root)
    add_asset(root, "debug", "unit", "archive")
    add_asset(root, "debug", "unit", "archive")
    assert_eq(refusal(root), "")
    state = replay(load_events(root).unwrap(), root).unwrap()
    assert_eq(len(state[record_key("leaf", "1.2.0")].assets), 1)
    add_asset(root, "debug", "unit", "other archive")
    assert_eq(
        refusal(root),
        "events/000004-asset-crates-io-leaf-1.2.0.json: unit " + digest_text("unit") + " already has asset " + digest_text("archive") + "; a second archive for one unit is a determinism conflict",
    )
    published = TemporaryDirectory.try_new().unwrap()
    published_root = published.path()
    mut publication: Dict[str, JsonValue] = {}
    publication["source"] = JsonValue.object({
        "registry": JsonValue.string("https://github.com/rust-lang/crates.io-index"),
        "checksum": JsonValue.string(digest_text("leaf")),
    })
    publication["notes"] = JsonValue.string("")
    append_event(published_root, "publish", "leaf", "1.2.0", "tests", publication).unwrap()
    add_asset(published_root, "debug", "unit", "archive")
    assert_eq(
        refusal(published_root),
        "events/000002-asset-crates-io-leaf-1.2.0.json: an asset is compiled from an adopted source Loaf; leaf 1.2.0 is not adopted",
    )


def test_an_asset_needs_no_fact_for_its_binding() -> None:
    """A package without a build script compiles under any binding; its harvested empty fact covers only one."""
    directory = TemporaryDirectory.try_new().unwrap()
    root = directory.path()
    adopt_leaf(root)
    mut fact = binding_json("release")
    fact.set("cfg", JsonValue.array([])).unwrap()
    mut payload: Dict[str, JsonValue] = {}
    payload["fact"] = fact
    payload["evidence"] = JsonValue.object({"method": JsonValue.string("test")})
    append_event(root, "fact", "leaf", "1.2.0", "tests", payload).unwrap()
    add_asset(root, "release", "release unit", "release archive")
    assert_eq(refusal(root), "")
    add_asset(root, "debug", "debug unit", "debug archive")
    assert_eq(refusal(root), "")


def test_the_asset_manifest_lists_every_asset_beside_the_manifest() -> None:
    directory = TemporaryDirectory.try_new().unwrap()
    root = directory.path()
    adopt_leaf(root)
    add_asset(root, "release", "b", "archive b")
    add_asset(root, "debug", "a", "archive a")
    events = load_events(root).unwrap()
    files = render_projections(replay(events, root).unwrap(), events).unwrap()
    manifest = parse(files["crates-io/leaf/1.2.0/assets.json"]).unwrap()
    assets = manifest.get("assets").unwrap().as_array().unwrap()
    assert_eq(len(assets), 2)
    assert_eq(canonical(assets[0].get("binding").unwrap()).unwrap(), canonical(binding_json("debug")).unwrap())
    assert_eq(assets[1].get("unit_identity").unwrap().as_str().unwrap(), digest_text("b"))
    assert_eq(manifest.get("name").unwrap().as_str().unwrap(), "crates-io/leaf")
    assert_true(files["index/crates-io/leaf"].contains("\"assets\":2"))


def test_a_binding_tag_is_the_version_tag_and_twelve_hex_digits_of_the_binding() -> None:
    binding = Binding(toolchain="rustc 1.98.0 (88d9e12ae 2026-08-18)", target="aarch64-apple-darwin", profile="debug", features=["default"])
    digest = digest_text(canonical(binding.to_json()).unwrap())
    assert_eq(unit_tag("2.1.0+zstd.1.5.7", binding).unwrap(), "2.1.0_zstd.1.5.7-" + digest[7:19])


def result_unit(library: str) -> JsonValue:
    """One unit as `oven compile-closure` lists it in `incan.oven.closure/1`."""
    unit = digest_text("unit")
    return JsonValue.object({
        "entry": JsonValue.string(unit),
        "unit": JsonValue.string(unit),
        "payload_digest": JsonValue.string(digest_bytes(b"rlib")[7:]),
        "loaf": JsonValue.string("crates-io/leaf"),
        "version": JsonValue.string("1.2.0"),
        "registry": JsonValue.string("loaves.pub"),
        "revision": JsonValue.int(1),
        "features": JsonValue.array([JsonValue.string("default")]),
        "domain": JsonValue.string("target"),
        "kind": JsonValue.string("lib"),
        "profile": JsonValue.string("release"),
        "target": JsonValue.string("aarch64-apple-darwin"),
        "name": JsonValue.string("leaf-0123456789abcdef"),
        "artifact": JsonValue.string(library),
        "dependencies": JsonValue.array([]),
        "refusal": JsonValue.string(""),
    })


def result_with(directory: str, rlib: bytes, refused: str) -> str:
    """A compile-closure result directory holding one unit: its closure.json and its store entry."""
    unit = digest_text("unit")
    entry = "entries/sha256-" + unit[7:]
    library = entry + "/artifacts/libleaf-0123456789abcdef.rlib"
    record = result_unit(library)
    closure = JsonValue.object({
        "schema": JsonValue.string("incan.oven.closure/1"),
        "profile": JsonValue.string("release"),
        "toolchain": JsonValue.object({
            "rustc": JsonValue.string("rustc 1.98.0 (88d9e12ae 2026-08-18)"),
            "target": JsonValue.string("aarch64-apple-darwin"),
        }),
        "units": JsonValue.array([record]),
        "refused": parse(refused).unwrap(),
    })
    write_text(Path(directory + "/closure.json"), canonical(closure).unwrap(), "closure.json").unwrap()
    Path(directory + "/" + entry + "/artifacts").mkdir(parents=true, exist_ok=true).unwrap()
    write_text(Path(directory + "/" + entry + "/artifact.json"), canonical(record).unwrap(), "artifact.json").unwrap()
    Path(directory + "/" + library).write_bytes(rlib).unwrap()
    Path(directory + "/" + entry + "/artifacts/leaf.incngraph").write_bytes(b"graph").unwrap()
    Path(directory + "/" + entry + "/artifacts/library.portable-inputs").write_bytes(b"inputs").unwrap()
    return directory


def test_a_store_entry_packs_into_one_deterministic_archive() -> None:
    result = result_with(scratch("pack"), b"rlib", "[]")
    first = pack_closure(result, [], result).unwrap()
    second = pack_closure(result, [], result).unwrap()
    assert_eq(len(first), 1)
    assert_eq(first[0].archive, second[0].archive)
    assert_eq(first[0].name, "leaf")
    assert_eq(first[0].entry, digest_text("unit"))
    # The binding is the closure's Rust compiler and the unit's own target, profile and features.
    assert_eq(canonical(first[0].binding.to_json()).unwrap(), canonical(binding_json("release")).unwrap())
    mut paths: list[str] = []
    for entry in read_archive(Path(first[0].path).read_bytes().unwrap()).unwrap():
        paths.append(entry.path)
        if entry.path == "payload":
            assert_eq(digest_bytes(entry.data), digest_bytes(b"rlib"))
    assert_eq(
        ", ".join(paths),
        "artifact.json, artifacts/leaf.incngraph, artifacts/library.portable-inputs, payload",
    )
    corrupt = result_with(scratch("corrupt"), b"not the rlib", "[]")
    assert_eq(error_of(pack_closure(corrupt, [], corrupt)), "crates-io/leaf 1.2.0: its library is not " + digest_bytes(b"rlib"))


def test_a_result_publishes_only_what_compile_closure_wrote_whole() -> None:
    refused = result_with(scratch("refused"), b"rlib", "[{\"loaf\":\"crates-io/zstd-sys\",\"reason\":\"link work\"}]")
    assert_true(error_of(closure_units(refused)).contains("the closure refused"))
    other = scratch("schema")
    write_text(Path(other + "/closure.json"), "{\"externs\":{},\"refused\":[]}", "closure.json").unwrap()
    assert_eq(
        error_of(closure_units(other)),
        other + "/closure.json: schema must be incan.oven.closure/1, the result `oven compile-closure` writes",
    )
    # A library outside the unit's own entry is refused before anything is read.
    outside = scratch("outside")
    record = result_unit("entries/sha256-" + digest_text("another")[7:] + "/artifacts/libleaf.rlib")
    closure = "{\"schema\":\"incan.oven.closure/1\",\"toolchain\":{\"rustc\":\"rustc 1.98.0\"},\"refused\":[],\"units\":[" + canonical(record).unwrap() + "]}"
    write_text(Path(outside + "/closure.json"), closure, "closure.json").unwrap()
    assert_true(error_of(closure_units(outside)).contains("`artifact` must name a file directly in entries/sha256-"))


def test_a_lock_names_the_archives_to_fetch() -> None:
    lock = (
        "format = 1\nmode = \"lowest\"\n\n[[loaf]]\nname = \"crates-io/leaf\"\nversion = \"1.2.0\"\norigin = \"registry\"\n"
        + "registry = \"loaves.pub\"\nrevision = 1\nchecksum = \"" + digest_text("leaf") + "\"\ndependencies = []\n\n"
        + "[[loaf]]\nname = \"std.json\"\nversion = \"0.6.0\"\norigin = \"toolchain\"\ndependencies = []\n"
    )
    archives = locked_archives(lock, "oven.lock").unwrap()
    assert_eq(len(archives), 1)
    assert_eq(archives[0].loaf, "crates-io/leaf")
    assert_eq(archives[0].digest, digest_text("leaf"))
    assert_true(error_of(locked_archives(lock.replace("checksum", "unchecked"), "oven.lock")).contains("names no `sha256:` checksum"))
    assert_true(error_of(locked_archives("format = 2\n", "oven.lock")).contains("format 1"))
    resolution = "{\"schema\":\"incan.oven.loaf-resolution/1\",\"units\":[{\"loaf\":\"crates-io/leaf\",\"version\":\"1.2.0\",\"archive_digest\":\"" + digest_text("leaf") + "\"}]}"
    assert_eq(locked_archives(resolution, "lock.json").unwrap()[0].digest, digest_text("leaf"))


def packed_as(unit: str, archive: str) -> Packed:
    return Packed(
        name="leaf",
        version="1.2.0",
        unit=digest_text(unit),
        entry=digest_text("entry " + unit),
        payload=digest_text("payload"),
        binding=Binding(toolchain="rustc 1.98.0 (88d9e12ae 2026-08-18)", target="aarch64-apple-darwin", profile="debug", features=["default"]),
        archive=digest_text(archive),
        path="",
    )


def test_a_unit_must_come_out_the_same_when_compiled_in_another_root() -> None:
    assert_eq(len(reproduction_differences([packed_as("unit", "archive")], [packed_as("unit", "archive")])), 0)
    assert_eq(
        reproduction_differences([packed_as("unit", "archive")], [packed_as("unit", "other bytes")]),
        ["leaf 1.2.0 is unit " + digest_text("unit") + " with archive " + digest_text("archive") + " in one root and unit " + digest_text("unit") + " with archive " + digest_text("other bytes") + " in the other"],
    )
    assert_eq(
        reproduction_differences([packed_as("unit", "archive")], []),
        ["leaf 1.2.0 was compiled in only one root", "one root compiled 1 unit(s) and the other 0"],
    )
