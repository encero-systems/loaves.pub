"""
Build-script recording: how the environment a script prints for the crate's compile becomes part of its fact.
"""

from std.fs import Path
from std.json import JsonValue
from std.testing import assert_eq, assert_is_err

from host import environment_value

from buildscript import closure_links, environment_entry, out_dir_includes, with_out_dir_suffixes
from tar import TarEntry


def test_a_value_appended_to_out_dir_is_a_literal_and_names_an_input() -> None:
    # crunchy 0.2.4 prints `rustc-env=CRUNCHY_LIB_SUFFIX=/lib.rs` and includes `OUT_DIR` followed by it.
    files = [
        TarEntry(path="build.rs", executable=false, data=b"fn main() {}\n"),
        TarEntry(
            path="src/lib.rs",
            executable=false,
            data=b"include!(concat!(env!(\"OUT_DIR\"), env!(\"CRUNCHY_LIB_SUFFIX\")));\n",
        ),
    ]
    entry = environment_entry("CRUNCHY_LIB_SUFFIX=/lib.rs", "/work/out", "crunchy 0.2.4").unwrap()
    assert_eq("\t".join(entry), "CRUNCHY_LIB_SUFFIX\thost\t/lib.rs")
    settled = with_out_dir_suffixes(files, "build.rs", [entry], "crunchy 0.2.4").unwrap()
    assert_eq("\t".join(settled[0]), "CRUNCHY_LIB_SUFFIX\tliteral\t/lib.rs")
    assert_eq(",".join(out_dir_includes(files, "build.rs", settled)), "lib.rs")


def test_a_host_path_the_crate_reads_on_its_own_is_refused() -> None:
    files = [TarEntry(path="src/lib.rs", executable=false, data=b"const TOOL: &str = env!(\"TOOL\");\n")]
    entry = environment_entry("TOOL=/usr/bin/tool", "/work/out", "tool 1.0.0").unwrap()
    assert_is_err(with_out_dir_suffixes(files, "build.rs", [entry], "tool 1.0.0"))
    # A host path no source reads says nothing a consumer could check, so it is refused as well.
    assert_is_err(with_out_dir_suffixes([], "build.rs", [entry], "tool 1.0.0"))


def test_a_path_below_out_dir_is_stated_relative_to_it() -> None:
    assert_eq("\t".join(environment_entry("ISLE_DIR=/work/out/isle/", "/work/out", "c 1.0.0").unwrap()), "ISLE_DIR\tout\tisle")
    assert_eq("\t".join(environment_entry("DIR=/work/out", "/work/out", "c 1.0.0").unwrap()), "DIR\tout\t.")
    assert_eq("\t".join(environment_entry("FAMILY=unix", "/work/out", "c 1.0.0").unwrap()), "FAMILY\tliteral\tunix")


def closure_result(units: str, refused: str) -> str:
    """A compile-closure result directory holding only `closure.json`, as `oven compile-closure` writes it."""
    directory = environment_value("TMPDIR").unwrap_or("/tmp").strip() + "/loaves-pub-buildscript-closure"
    path = Path(directory)
    if path.is_dir():
        path.remove_tree().unwrap()
    path.mkdir(parents=true, exist_ok=true).unwrap()
    document = "{\"schema\": \"incan.oven.closure/1\", \"units\": [" + units + "], \"refused\": [" + refused + "]}"
    Path(directory + "/closure.json").write_text(document, "utf-8", "strict", None).unwrap()
    return directory


def cc_root() -> JsonValue:
    return JsonValue.object({"name": JsonValue.string("cc"), "loaf": JsonValue.string("crates-io/cc")})


def test_a_build_script_links_the_units_compile_closure_compiled_for_its_roots() -> None:
    cc = "{\"loaf\": \"crates-io/cc\", \"name\": \"cc\", \"artifact\": \"entries/sha256-aa/artifacts/libcc-1.rlib\"}"
    shlex = "{\"loaf\": \"crates-io/shlex\", \"name\": \"shlex\", \"artifact\": \"entries/sha256-bb/artifacts/libshlex-2.rlib\"}"
    directory = closure_result(cc + ", " + shlex, "")
    flags = closure_links(directory, [cc_root()], "ring 0.17.14").unwrap()
    assert_eq(len(flags), 3)
    assert_eq(" ".join(flags[0]), f"--extern cc={directory}/entries/sha256-aa/artifacts/libcc-1.rlib")
    assert_eq(" ".join(flags[1]), f"-L dependency={directory}/entries/sha256-aa/artifacts")
    assert_eq(" ".join(flags[2]), f"-L dependency={directory}/entries/sha256-bb/artifacts")


def test_a_closure_that_refused_or_missed_a_root_is_refused() -> None:
    refused = closure_result("", "{\"loaf\": \"crates-io/cc\", \"version\": \"1.2.57\", \"reason\": \"no fact\"}")
    assert_is_err(closure_links(refused, [cc_root()], "ring 0.17.14"))
    missing = closure_result("{\"loaf\": \"crates-io/shlex\", \"name\": \"shlex\", \"artifact\": \"entries/sha256-bb/artifacts/libshlex-2.rlib\"}", "")
    match closure_links(missing, [cc_root()], "ring 0.17.14"):
        Ok(_) => assert_eq("refused", "accepted")
        Err(message) => assert_eq(message, "ring 0.17.14: the closure compiled no unit of crates-io/cc")
