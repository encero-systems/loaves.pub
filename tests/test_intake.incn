"""
Intake (encero-systems/loaves.pub#17): the release-age floor and the two hazard signals, on index lines written here,
and automatic selection passing over what they hold back.
"""

from std.json import JsonValue
from std.testing import assert_eq, assert_true

from closure import choose
from intake import RELEASE_AGE_FLOOR_HOURS, intake_problems, unix_seconds

# 2026-11-23T12:00:00Z
const NOW: int = 1795435200


def line(version: str, pubtime: str, deps: list[str], yanked: bool) -> JsonValue:
    mut listed: list[JsonValue] = []
    for name in deps:
        listed.append(JsonValue.object({"name": JsonValue.string(name), "req": JsonValue.string("^1"), "kind": JsonValue.string("normal")}))
    return JsonValue.object({
        "name": JsonValue.string("widget"),
        "vers": JsonValue.string(version),
        "deps": JsonValue.array(listed),
        "pubtime": JsonValue.string(pubtime),
        "yanked": JsonValue.bool(yanked),
    })


def old(version: str, deps: list[str]) -> JsonValue:
    return line(version, "2026-01-01T00:00:00Z", deps, false)


def problems(lines: list[JsonValue], index: int) -> list[str]:
    return intake_problems(lines, lines[index], NOW).unwrap()


def test_a_publish_time_reads_as_unix_seconds() -> None:
    assert_eq(unix_seconds("2022-03-24T14:24:21Z").unwrap(), 1648131861)
    assert_eq(unix_seconds("2022-03-24T14:24:21.123456Z").unwrap(), 1648131861)
    assert_eq(unix_seconds("2022-03-24T14:24:21+00:00").unwrap(), 1648131861)
    assert_eq(unix_seconds("2000-02-29T00:00:00Z").unwrap(), 951782400)
    assert_eq(unix_seconds("2026-11-23T12:00:00Z").unwrap(), NOW)
    match unix_seconds("2022-03-24 14:24:21"):
        Ok(_) => assert_true(false)
        Err(message) => assert_eq(message, "`2022-03-24 14:24:21` is not a UTC time")


def test_a_version_younger_than_the_floor_is_held_back() -> None:
    assert_eq(RELEASE_AGE_FLOOR_HOURS, 72)
    fresh = [line("1.0.0", "2026-11-23T10:00:00Z", [], false)]
    assert_eq(problems(fresh, 0), ["published 2026-11-23T10:00:00Z, 2 h ago, under the 72 h release-age floor"])
    settled = [line("1.0.0", "2026-11-20T11:59:59Z", [], false)]
    assert_eq(problems(settled, 0), [])
    unknown = [line("1.0.0", "", [], false)]
    assert_eq(problems(unknown, 0), ["crates.io gives no publish time for it, so its age is unknown"])


def test_a_patch_release_that_adds_a_dependency_is_held_back() -> None:
    lines = [old("1.2.0", ["serde"]), old("1.2.1", ["serde", "payload"]), old("1.3.0", ["serde", "other"])]
    assert_eq(problems(lines, 1), ["a patch release adding dependencies 1.2.0 did not have: payload"])
    # A minor release may bring new dependencies; only a patch release is held to its predecessor's.
    assert_eq(problems(lines, 2), [])
    assert_eq(problems(lines, 0), [])


def test_a_renamed_or_development_dependency_counts_as_the_package_it_builds_with() -> None:
    mut earlier_deps: list[JsonValue] = [JsonValue.object({"name": JsonValue.string("json"), "package": JsonValue.string("serde_json"), "req": JsonValue.string("^1")})]
    mut later_deps: list[JsonValue] = [
        JsonValue.object({"name": JsonValue.string("sj"), "package": JsonValue.string("serde_json"), "req": JsonValue.string("^1")}),
        JsonValue.object({"name": JsonValue.string("criterion"), "req": JsonValue.string("^0.5"), "kind": JsonValue.string("dev")}),
    ]
    earlier = JsonValue.object({"name": JsonValue.string("widget"), "vers": JsonValue.string("1.0.0"), "deps": JsonValue.array(earlier_deps), "pubtime": JsonValue.string("2026-01-01T00:00:00Z")})
    later = JsonValue.object({"name": JsonValue.string("widget"), "vers": JsonValue.string("1.0.1"), "deps": JsonValue.array(later_deps), "pubtime": JsonValue.string("2026-01-02T00:00:00Z")})
    assert_eq(intake_problems([earlier, later], later, NOW).unwrap(), [])


def test_a_burst_of_yanks_at_the_head_of_a_crate_holds_it_back() -> None:
    mut lines = [old("1.0.0", []), old("1.0.1", []), old("1.0.2", [])]
    lines.append(line("1.0.3", "2026-01-01T00:00:00Z", [], true))
    lines.append(line("1.0.4", "2026-01-01T00:00:00Z", [], true))
    assert_eq(problems(lines, 2), [])
    lines.append(line("1.0.5", "2026-01-01T00:00:00Z", [], true))
    assert_eq(problems(lines, 2), ["3 of the crate's 5 newest versions are yanked"])


def test_selection_passes_over_a_held_back_version_and_says_why_when_none_qualifies() -> None:
    lines = [old("1.2.0", ["serde"]), line("1.2.1", "2026-11-23T10:00:00Z", ["serde"], false)]
    assert_eq(choose(lines, "widget", "^1", NOW).unwrap(), "1.2.0")
    only_fresh = [line("1.2.1", "2026-11-23T10:00:00Z", [], false)]
    match choose(only_fresh, "widget", "^1", NOW):
        Ok(_) => assert_true(false)
        Err(message) => assert_eq(message, "no crates.io version of widget satisfying `^1` passes intake: 1.2.1: published 2026-11-23T10:00:00Z, 2 h ago, under the 72 h release-age floor")


def test_selection_still_prefers_a_version_that_is_not_yanked() -> None:
    lines = [old("1.0.0", []), line("1.0.1", "2026-01-01T00:00:00Z", [], true)]
    assert_eq(choose(lines, "widget", "^1", NOW).unwrap(), "1.0.0")
